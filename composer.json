{
  "name": "lipemat/cmb2",
  "description": "Fork if CMB2 with many added features for a clean UI.",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Justin Sternberg",
      "email": "justin@dsgnwrks.pro",
      "homepage": "https://dsgnwrks.pro",
      "role": "Developer"
    },
    {
      "name": "WebDevStudios",
      "email": "contact@webdevstudios.com",
      "homepage": "https://github.com/WebDevStudios",
      "role": "Developer"
    },
    {
      "name": "Mat Lipe",
      "email": "mat@onpointplugins.com",
      "homepage": "https://onpointplugins.com",
      "role": "Developer"
    }
  ],
  "keywords": [
    "wordpress",
    "plugin",
    "metabox"
  ],
  "homepage": "https://github.com/lipemat/CMB2",
  "type": "wordpress-plugin",
  "support": {
    "issues": "https://github.com/lipemat/CMB2/issues",
    "source": "https://github.com/lipemat/CMB2"
  },
  "require": {
    "php": ">=7.4.0"
  },
  "suggest": {
    "composer/installers": "~1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^1.1"
  },
  "scripts": {
    "test": [
      "vendor/bin/phpunit"
    ],
    "phpcs:install": "@composer install --working-dir=tools/phpcs --no-interaction",
    "phpcs": "@php tools/phpcs/run.php phpcs",
    "phpcbf": "@php tools/phpcs/run.php phpcbf",
    "post-install-cmd": [
      "@php tools/phpcs/maybe-install.php"
    ],
    "post-update-cmd": [
      "@php tools/phpcs/maybe-install.php"
    ]
  },
  "replace": {
    "cmb2/cmb2": "*"
  },
  "autoload": {
    "files": [
      "init.php"
    ]
  }
}
